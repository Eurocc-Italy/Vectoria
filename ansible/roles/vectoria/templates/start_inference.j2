#!/bin/bash

#SBATCH --account={{ account }}
#SBATCH --job-name=inference
#SBATCH --output=%j.out
#SBATCH --error=%j.err
#SBATCH --partition={{ partition }}
#SBATCH --time 00:15:00     # format: HH:MM:SS
#SBATCH --nodes 1           # 1 node
#SBATCH --ntasks-per-node=1 # 1 task
#SBATCH --cpus-per-task={{ cpus }}  
#SBATCH --gres=gpu:{{ gpus }}
##SBATCH --exclusive        # reserve full node for job
                            # NOTE: gpu/cpu requirements will be ignored

export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True  # Avoid fragmentation

export TMPDIR={{ tmpdir }}
export TMP={{ tmpdir }}

# NOTE: the following section is experimental and is commented out by default.
# Only use if you have enough RAM on the compute node.

# #-------------------------------------------------------

# # COPY MODEL ON REMOTE NODE'S RAM BEFORE EXECUTION
